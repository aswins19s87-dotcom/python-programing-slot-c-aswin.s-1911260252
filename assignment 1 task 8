#task8
total = 0.0
try:
    n = int(input("Enter number of milk entries: "))
    for i in range(n):
        print("Entry", i + 1)
        farmer_id = input("Enter farmer ID: ")
        litres = float(input("Enter litres: "))
        fat = float(input("Enter fat: "))
        snf = float(input("Enter SNF: "))
        if litres <= 0 or not (2.0 <= fat <= 7.0) or not (6.0 <= snf <= 10.0):
            print("Invalid data")
            continue
        fat_steps = round((fat - 3.5) / 0.1)
        snf_steps = round((snf - 8.5) / 0.1)
        rate = round(30 + fat_steps * 0.48 + snf_steps * 0.30, 2)
        amount = round(litres * rate, 2)
        total += amount
        print("Farmer ID:", farmer_id)
        print(f"Rate = Rs {rate:.2f}")
        print(f"Payment = Rs {amount:.2f}")
    print(f"Total = Rs {total:.2f}")
except ValueError:
    print("Invalid input. Enter numbers correctly.")
