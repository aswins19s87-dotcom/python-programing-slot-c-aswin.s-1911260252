def calculate(litres,fat,snf,month):
    base=32.00 if month in (4,5,6) else 30.00
    fs=round((round(fat,2)-3.50)/0.10)
    ss=round((round(snf,2)-8.50)/0.10)
    rate=round(base+fs*0.48+ss*0.30,2)
    return rate,round(litres*rate,2)
litres=float(input("Enter litres: "))
fat=float(input("Enter fat: "))
snf=float(input("Enter SNF: "))
month=int(input("Enter month (1-12): "))
rate,amount=calculate(litres,fat,snf,month)
print(f"Fat: {fat:.2f}% | SNF: {snf:.2f}%")
print(f"Seasonal rate: Rs {rate:.2f}")
print(f"Payment: Rs {amount:.2f}")
